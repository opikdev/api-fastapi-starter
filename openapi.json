  "components": {
    "schemas": {
      "CreateNote": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Title"
          },
          "body": {
            "type": "string",
            "maxLength": 10000,
            "title": "Body",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "title"
        ],
        "title": "CreateNote"
      },
      "CreateSession": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email",
            "title": "Email",
            "examples": [
              "demo@example.com"
            ]
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 12,
            "title": "Password",
            "examples": [
              "correct-horse-battery"
            ]
          },
          "delivery": {
            "type": "string",
            "enum": [
              "body",
              "cookie"
            ],
            "title": "Delivery",
            "description": "`body` returns the token. `cookie` sets it in an httpOnly `__Host-session` cookie instead, for a browser app on the same origin as the API.",
            "default": "body",
            "examples": [
              "cookie"
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "CreateSession"
      },
      "Credentials": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email",
            "title": "Email",
            "examples": [
              "demo@example.com"
            ]
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 12,
            "title": "Password",
            "examples": [
              "correct-horse-battery"
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "Credentials"
      },
      "FieldError": {
        "properties": {
          "field": {
            "type": "string",
            "title": "Field"
          },
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "field",
          "detail"
        ],
        "title": "FieldError"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status",
            "default": "ok"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Health"
      },
      "NoteList": {
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/NoteOut"
            },
            "type": "array",
            "title": "Data"
          },
          "meta": {
            "$ref": "#/components/schemas/PageMeta"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "data",
          "meta"
        ],
        "title": "NoteList"
      },
      "NoteOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "examples": [
              "note_0190a7e4c1d27c3e9b8f6a5d4c3b2a10"
            ]
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "body": {
            "type": "string",
            "title": "Body"
          },
          "version": {
            "type": "integer",
            "title": "Version"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "title": "Createdat"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "title": "Updatedat"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "title",
          "body",
          "version",
          "createdAt",
          "updatedAt"
        ],
        "title": "NoteOut"
      },
      "PageMeta": {
        "properties": {
          "limit": {
            "type": "integer",
            "title": "Limit"
          },
          "nextCursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Nextcursor"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "limit",
          "nextCursor"
        ],
        "title": "PageMeta"
      },
      "ProblemBody": {
        "properties": {
          "type": {
            "type": "string",
            "title": "Type"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "status": {
            "type": "integer",
            "title": "Status"
          },
          "detail": {
            "type": "string",
            "title": "Detail"
          },
          "instance": {
            "type": "string",
            "title": "Instance"
          },
          "errors": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/FieldError"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Errors"
          }
        },
        "type": "object",
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "instance"
        ],
        "title": "ProblemBody",
        "description": "The JSON body of every error response."
      },
      "SessionOut": {
        "properties": {
          "token": {
            "type": "string",
            "title": "Token",
            "description": "Present when `delivery` is `body`. Send it as `Authorization: Bearer <token>`."
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "title": "Expiresat"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "expiresAt"
        ],
        "title": "SessionOut"
      },
      "UpdateNote": {
        "properties": {
          "title": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          },
          "body": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 10000
              },
              {
                "type": "null"
              }
            ],
            "title": "Body"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "UpdateNote"
      },
      "UserOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "examples": [
              "usr_0190a7e4c1d27c3e9b8f6a5d4c3b2a10"
            ]
          },
          "email": {
            "type": "string",
            "title": "Email"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "title": "Createdat"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "email",
          "createdAt"
        ],
        "title": "UserOut"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "description": "A session token from POST /v1/sessions.",
        "scheme": "bearer"
      },
      "cookieAuth": {
        "type": "apiKey",
        "description": "The cookie POST /v1/sessions sets when `delivery` is `cookie`.",
        "in": "cookie",
        "name": "__Host-session"
      }
    }
  }
}
