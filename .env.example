# Dev-only credentials, matching compose.yaml. Replace them everywhere else.
DATABASE_URL=postgresql://api_app:api_app_dev_password@127.0.0.1:5432/api
MIGRATION_DATABASE_URL=postgresql://api_owner:api_owner_dev_password@127.0.0.1:5432/api

PORT=3000
LOG_LEVEL=info
DATABASE_STATEMENT_TIMEOUT_MS=5000
DATABASE_POOL_MAX=10

# Comma-separated browser origins. Leave empty to disable CORS.
CORS_ORIGINS=

# How many proxies in front of the API append to X-Forwarded-For. 0 ignores the header.
TRUST_PROXY_HOPS=0

# Session lifetime in hours. At most 9600 (400 days), the longest a browser keeps a cookie.
SESSION_TTL_HOURS=168
RATE_LIMIT_PER_MINUTE=300
AUTH_RATE_LIMIT_PER_MINUTE=10

# Set to send traces and errors to an OTLP collector.
OTEL_EXPORTER_OTLP_ENDPOINT=
