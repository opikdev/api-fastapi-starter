# Dev-only credentials, matching compose.yaml. Replace them everywhere else.
# Compose reads POSTGRES_PORT from here too, so change the port in one place.
POSTGRES_PORT=5432
DATABASE_URL=postgresql://api_app:api_app_dev_password@127.0.0.1:${POSTGRES_PORT}/api
MIGRATION_DATABASE_URL=postgresql://api_owner:api_owner_dev_password@127.0.0.1:${POSTGRES_PORT}/api

PORT=3000
LOG_LEVEL=info
DATABASE_STATEMENT_TIMEOUT_MS=5000
DATABASE_POOL_MAX=10

# Comma-separated browser origins. Leave empty to disable CORS.
CORS_ORIGINS=

# How many proxies in front of the API append to X-Forwarded-For. 0 ignores the header.
TRUST_PROXY_HOPS=0

# Session lifetime in hours. At most 9600 (400 days), the longest a browser keeps a cookie.
SESSION_TTL_HOURS=168
RATE_LIMIT_PER_MINUTE=300
AUTH_RATE_LIMIT_PER_MINUTE=10
# Failed logins per email before it's locked for the rest of the window.
LOGIN_FAILURE_LIMIT=5
LOGIN_FAILURE_WINDOW_SECONDS=900

# On SIGTERM: fail /readyz and keep serving for the drain, then let requests finish within the timeout.
SHUTDOWN_DRAIN_SECONDS=5
SHUTDOWN_TIMEOUT_SECONDS=30
# Keep idle connections open longer than your load balancer does, such as AWS ALB's 60 seconds.
KEEP_ALIVE_TIMEOUT_SECONDS=75

# Serves /docs and /openapi.json. Off by default; leave it off in production unless you mean it.
DOCS_ENABLED=true

# Set to send traces, metrics, and errors to an OTLP collector.
OTEL_EXPORTER_OTLP_ENDPOINT=
